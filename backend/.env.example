# Copy this file to .env and replace every placeholder before any real
# deployment. These values are non-secret placeholders for local runs only.

# MySQL connection. The host is the Compose service name of the database.
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=workshop
MYSQL_USER=workshop_app
MYSQL_PASSWORD=replace_with_secure_password

# HTTP server
HTTP_PORT=8080
ALLOWED_ORIGIN=http://localhost:4173
REQUEST_TIMEOUT_SECOND=15
DATABASE_TIMEOUT_SECOND=5

# Session token signing key. Replace it with a long random value per
# environment; a token signed with a leaked key grants full access.
TOKEN_SECRET=replace_with_long_random_token_secret
TOKEN_TTL_MINUTE=480

# Marks the session cookie Secure (HTTPS only). Defaults to true; a browser
# never sends a Secure cookie over plain HTTP, so set this to false only for
# a local run without TLS (e.g. `npm run dev` against this backend on
# http://localhost).
COOKIE_SECURE=true
