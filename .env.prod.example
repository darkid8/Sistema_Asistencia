# Copy to .env in the project root and replace every placeholder before any
# real deployment. Used by docker-compose.prod.yml.

# MySQL
MYSQL_DATABASE=workshop
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_password
MYSQL_USER=workshop_app
MYSQL_PASSWORD=replace_with_a_different_long_random_password

# Backend
# Generate with: openssl rand -base64 48
TOKEN_SECRET=replace_with_a_long_random_token_secret
TOKEN_TTL_MINUTE=480
# Exact public origin, scheme + host, no trailing slash.
ALLOWED_ORIGIN=https://tu-dominio.com

# Bootstrap seed (database/seed/0001_seed_bootstrap.sql). Generate a real
# hash with: go run ./backend/cmd/hash-password
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrador del taller
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash

TECHNICIAN_ONE_USERNAME=jperez
TECHNICIAN_ONE_FULL_NAME=Juan Perez
TECHNICIAN_ONE_SPECIALTY=Motor y transmision
TECHNICIAN_TWO_USERNAME=lramirez
TECHNICIAN_TWO_FULL_NAME=Laura Ramirez
TECHNICIAN_TWO_SPECIALTY=Frenos y suspension
