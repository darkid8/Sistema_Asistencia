# Copy this file to .env and replace every placeholder before any real
# deployment. These values are non-secret placeholders for local
# validation only.

# MySQL service
MYSQL_DATABASE=workshop
MYSQL_ROOT_PASSWORD=replace_with_secure_root_password
MYSQL_USER=workshop_app
MYSQL_PASSWORD=replace_with_secure_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Bootstrap administrator inserted by database/seed/0001_seed_bootstrap.sql.
# ADMIN_PASSWORD_HASH is a bcrypt hash, never a plaintext password. The
# value below hashes the documented first-login password Admin2026* and
# must be replaced with a hash of a new password before any real
# deployment.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrador del taller
ADMIN_PASSWORD_HASH='$2a$10$l6MHGFLFig59/CZavFTJl.a6Y6RYTf7Rw.iboJv.Uws6tfS3E58cq'

# Bootstrap technician profiles inserted by the same seed. They reuse the
# administrator bootstrap hash so the workshop is operable on first start.
TECHNICIAN_ONE_USERNAME=jperez
TECHNICIAN_ONE_FULL_NAME=Juan Perez
TECHNICIAN_ONE_SPECIALTY=Motor y transmision
TECHNICIAN_TWO_USERNAME=lramirez
TECHNICIAN_TWO_FULL_NAME=Laura Ramirez
TECHNICIAN_TWO_SPECIALTY=Frenos y suspension
